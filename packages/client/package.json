{
  "name": "@raby-red/client",
  "version": "1.0.0",
  "description": "RabyRed Electron Desktop App",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "./node_modules/.bin/electron .",
    "dev:watch": "tsc --watch",
    "build": "tsc && pnpm build:deps && pnpm build:deploy",
    "build:deps": "pnpm --filter @raby-red/proxy-server build && pnpm --filter @raby-red/admin-server build",
    "build:deploy": "rm -rf ../../deploy && pnpm deploy:proxy && pnpm deploy:admin",
    "deploy:proxy": "cd ../.. && pnpm --filter @raby-red/proxy-server deploy --prod --legacy deploy/proxy-server",
    "deploy:admin": "cd ../.. && pnpm --filter @raby-red/admin-server deploy --prod --legacy deploy/admin-server",
    "start": "./node_modules/.bin/electron .",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "electron-log": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.rabyred.app",
    "productName": "RabyRed",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../deploy/proxy-server",
        "to": "app/proxy-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../deploy/admin-server",
        "to": "app/admin-server",
        "filter": [
          "**/*",
          "!data/rules.json"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
